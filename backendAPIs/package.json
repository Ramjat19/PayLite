{
  "name": "paylite-mock-api",
  "version": "1.0.0",
  "private": true,
  "description": "PayLite API with Prisma/PostgreSQL persistence.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
